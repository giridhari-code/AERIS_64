# Copy to .env and fill values. Never commit real secrets.

# --- model (server reads NEUROFIELD_* first; CHECKPOINT/CONFIG/DEVICE still work) ---
NEUROFIELD_CHECKPOINT=/app/checkpoints/model        # folder: model.safetensors + config.json + tokenizer.json
# NEUROFIELD_CONFIG=/app/configs/default.yaml       # optional; weight shapes override model dims
NEUROFIELD_DEVICE=cuda
# NEUROFIELD_DTYPE=bfloat16                         # autocast; weights stay fp32
# NEUROFIELD_STRICT_LOAD=1                          # refuse checkpoints with missing weights

# --- server ---
NEUROFIELD_HOST=0.0.0.0
NEUROFIELD_PORT=8000
NEUROFIELD_WORKERS=1
NEUROFIELD_LOG_JSON=1
# NEUROFIELD_SESSION_TTL=1800
# NEUROFIELD_MAX_SESSIONS=256
# NEUROFIELD_TRUST_PROXY=1                          # only behind a proxy you control

# --- security ---
# NEUROFIELD_API_KEYS=change-me-1,change-me-2       # empty => API is OPEN
# NEUROFIELD_METRICS_PUBLIC=0
# NEUROFIELD_ALLOW_PICKLE=0                         # 1 only for legacy .pt files you trust

# Optional
# CUDA_VISIBLE_DEVICES=0
# WANDB_API_KEY=
# HF_TOKEN=
