[Unit]
Description=NeuroField Inference Server
After=network.target

[Service]
Type=simple
User=neurofield
Group=neurofield
WorkingDirectory=/opt/neurofield
EnvironmentFile=/opt/neurofield/.env
ExecStart=/opt/neurofield/.venv/bin/uvicorn "neurofield.serving.server:create_app" --factory \
    --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/neurofield/logs

[Install]
WantedBy=multi-user.target
